# Copy this file to .env.local and fill in what you use. Never commit real keys.

# Blog images (npm run images). The first key that is set is used; with none, placeholders are drawn.
# Google Gemini API key from https://aistudio.google.com/apikey (preferred image provider).
GEMINI_API_KEY=
# OpenAI API key, used only if GEMINI_API_KEY is empty.
OPENAI_API_KEY=
# Replicate API token (FLUX.1 schnell), used only if both keys above are empty.
REPLICATE_API_TOKEN=

# Site settings (public, baked into the build).
# Google AdSense publisher ID, e.g. ca-pub-1234567890123456.
NEXT_PUBLIC_ADSENSE_CLIENT=
# Google Search Console HTML-tag verification code (the content="..." value only).
NEXT_PUBLIC_GSC_VERIFICATION=
# Amazon Associates tracking tag, e.g. coolwave-20.
NEXT_PUBLIC_AMAZON_TAG=
